# Agent Sentinel — Environment Variables
# Copy this file and rename the copy to:   .env.local
# (Keep this .env.local.example file as-is — it is safe to commit to git)

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED: Your OpenRouter API key.
# How to get one: https://openrouter.ai/keys  (free, no credit card required)
# ─────────────────────────────────────────────────────────────────────────────
VITE_OPENROUTER_API_KEY=your-openrouter-key-here

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Legacy Gemini key (only needed if you are still using geminiService.ts)
# ─────────────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY=your-gemini-key-here
